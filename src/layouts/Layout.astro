---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Michael | Diseño y Desarrollo Web",
  description = "Diseño y desarrollo páginas web modernas para negocios, profesionales y emprendedores.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
    <script>
      import "../scripts/reveal.js";
      import "../scripts/parallax.js";
      import "../scripts/projectMotion.js";
    </script>
  </body>
</html>
