---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MichaelWeb | Diseño y Desarrollo Web",
  description = "Diseño y desarrollo páginas web modernas para negocios, profesionales y emprendedores.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
    <script>
      import "../scripts/reveal.js";
      import "../scripts/parallax.js";
    </script>
  </body>
</html>
